; Deprecated: retained for reference only. The refinement harness now enforces
; host read isolation with a Docker container mount set, which works on macOS,
; Linux, and Windows alike. No script reads this profile any more.
; Historical macOS runs used it through `sandbox-exec -f <profile>` with the
; placeholders below filled in by run-refinement-case.sh.
(version 1)
(allow default)

(deny file-read*
  (subpath "__REPO__")
  (subpath "__NORMAL_CODEX_HOME__")
  (subpath "__NORMAL_AGENTS_HOME__"))
