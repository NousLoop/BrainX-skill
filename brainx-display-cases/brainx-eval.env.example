# Copy to brainx-eval.env (git-ignored) or export these before invoking
# build-eval-image.sh or run-refinement-case.sh; both source this file when it
# exists next to the script. BRAINX_REPO and OPENAI_API_KEY are required.

# Skill-bundle checkout used as the source of the frozen skill snapshot.
# POSIX-style path; on Windows Git Bash use /c/... form, on macOS/Linux an
# absolute path like ~/work/BrainX-skill.
BRAINX_REPO="<path-to-your-BrainX-skill-checkout>"

# Python always comes from the Linux evaluation image; do not mount host venvs.

# Container image that runs the agent. It must contain `codex`, `node`, and a
# Linux BrainX virtualenv mounted at BRAINX_VENV_IN_IMAGE.
# Build it with `bash brainx-display-cases/build-eval-image.sh`, then reuse the
# same dated tag for every compared run.
BRAINX_EVAL_IMAGE="brainx-eval:latest"
BRAINX_VENV_IN_IMAGE="/brainx-venv"

# Image build arguments. Pin both for a reproducible evaluation.
# BRAINX_RELEASE=2026.7.9      # empty lets pip pick the latest release
# BRAINX_EXTRA=cpu             # cpu | cuda12 | cuda13 | tpu
# CODEX_VERSION=0.166.0        # npm version of @openai/codex, or `latest`
# BRAINX_PYTHON_VERSION=3.11   # BrainX requires Python >= 3.11
# BRAINX_NODE_VERSION=22.23.4      # official tarball used to install node

# Package mirrors. The defaults work in mainland China; override elsewhere.
# apt defaults to a Tsinghua mirror because deb.debian.org returns 502 behind
# some proxies.
# APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com

# Evaluation model, official OpenAI. Identical across every compared run.
BRAINX_EVAL_MODEL="gpt-6.1-sol"

# Model credential for the official OpenAI endpoint, required by
# run-refinement-case.sh. The harness injects it into the evaluator container
# as OPENAI_API_KEY; minimal-eval-config.toml reads it via the provider auth
# command. Keep it only in this git-ignored file (or export it); it must never
# be committed, archived, or baked into the image.
# OPENAI_API_KEY="sk-..."

# Host locations that must never be readable from inside the container.
NORMAL_CODEX_HOME="$HOME/.codex"
NORMAL_AGENTS_HOME="$HOME/.agents"
